# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@<cluster-url>/xssScannerDB?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/xssScannerDB

# JWT Authentication Secret Key
JWT_SECRET=xss_scanner_super_secret_jwt_key_2026

# Allowed Frontend URL (CORS) - Set to * or your deployed frontend domain
CLIENT_URL=*
